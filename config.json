{
    "data": {
        "file_path": "dataset/golub.csv",

        "cv_fraction":   0.6,
        "test_fraction": 0.4,

        "shuffle": true,
        "split_seed": 42
    },
    "training": {
        "n_splits": 3,
        "n_repeats": 3,
        "n_features_to_select": 30,
        "genes": [1, 2, 4, 8, 16, 32, 64, 128, 512, 1024, 2048],
        "alpha": [0.01, 0.02, 0.05, 0.1, 0.2],
        "C":     [0.1,  0.2, 0.3],

        "device": "cuda"
    },
    "output": {
        "preprocess_dir": "outputs/preprocess",
        "save_plots": false,
        "plots_dir": "outputs/plots",
        "checkpoints_dir": "outputs/checkpoints",
        "evaluate_dir": "outputs/eval"
    }
}