{
    "data": {
        "file_path": "dataset/golub.csv",

        "cv_fraction":   0.6,
        "test_fraction": 0.4,

        "shuffle": true,
        "split_seed": 42
    },
    "cv": {
        "alpha": 0.05,
        "C": 0.1
    },
    "training": {
        "n_splits": 5,
        "n_repeats": 10,
        "n_features_to_select": 30,

        "device": "cuda"
    },
    "bias_experiment": {
        "run": true,
        "gene_grid": [5, 10, 20, 50, 100, 200],
        "permute_labels": true
    },
    "output": {
        "preprocess_dir": "outputs/preprocess",
        "save_plots": true,
        "plots_dir": "outputs/plots",
        "checkpoints_dir": "outputs/checkpoints",
        "evaluate_dir": "outputs/eval"
    }
}